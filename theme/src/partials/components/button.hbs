{{#if (eq color "primary")}}
    {{~variable "buttonClass" "bg-primary md:hover:bg-secondary" ~}}
    {{~variable "textClass" "text-white" ~}}
    {{~variable "iconClass" "text-white" ~}}
{{else if (eq color "secondary")}}
    {{~variable "buttonClass" "bg-secondary md:hover:bg-primary" ~}}
    {{~variable "textClass" "text-white" ~}}
    {{~variable "iconClass" "text-white" ~}}
{{else if (eq color "black")}}
    {{~variable "buttonClass" "bg-black md:hover:bg-primary" ~}}
    {{~variable "textClass" "text-white" ~}}
    {{~variable "iconClass" "text-white" ~}}
{{else if (eq color "white")}}
    {{~variable "buttonClass" "bg-white border border-primary md:hover:bg-primary md:hover:border-white" ~}}
    {{~variable "textClass" "text-dark md:group-hover/btn:text-white" ~}}
    {{~variable "iconClass" "text-dark md:group-hover/btn:text-white" ~}}
{{else if (eq color "whatsapp")}}
    {{~variable "buttonClass" "bg-[#25D366] md:hover:bg-[#19b351]" ~}}
    {{~variable "textClass" "text-dark md:group-hover/btn:text-white" ~}}
    {{~variable "iconClass" "text-dark md:group-hover/btn:text-white" ~}}
{{/if}}
{{#if (eq type "button")}}
    <button type="{{buttonType}}" title="{{text}}" {{{attribute}}} {{#if data-src}}data-src="{{data-src}}"{{/if}} class="group/btn {{@root.buttonClass}} inline-flex items-center justify-center gap-2.5 clamp-[px,24px,32px] clamp-[py,12px,18px] rounded-xl min-w-max relative transition-colors duration-300 [[disabled]]:opacity-50 [[disabled]]:pointer-events-none max-xs:w-full {{class}}">
        <span class="{{@root.textClass}} clamp-[text,16px,18px] leading-tight font-medium tracking-[-0.18px] transition-colors duration-300">{{text}}</span>
        {{#if icon}}
            <i class="{{icon}} {{@root.iconClass}} clamp-[text,16px,18px] clamp-[h,16px,18px] transition-colors duration-300"></i>
        {{/if}}
    </button>
{{else if (eq type "div")}}
    <div title="{{text}}" {{{attribute}}} class="group/btn {{@root.buttonClass}} inline-flex items-center justify-center gap-2.5 clamp-[px,24px,32px] clamp-[py,12px,18px] rounded-xl min-w-max relative transition-colors duration-300 disabled:opacity-50 disabled:pointer-events-none max-xs:w-full {{class}}">
        <span class="{{@root.textClass}} clamp-[text,16px,18px] leading-tight font-medium tracking-[-0.18px] transition-colors duration-300">{{text}}</span>
        {{#if icon}}
            <i class="{{icon}} {{@root.iconClass}} clamp-[text,16px,18px] clamp-[h,16px,18px] transition-colors duration-300"></i>
        {{/if}}
    </div>
{{else}}
    <a href="{{url}}" title="{{text}}" {{{attribute}}} class="group/btn {{@root.buttonClass}} inline-flex items-center justify-center gap-2.5 clamp-[px,24px,32px] clamp-[py,12px,18px] rounded-xl min-w-max relative transition-colors duration-300 [[disabled]]:opacity-50 [[disabled]]:pointer-events-none max-xs:w-full {{class}}">
        <span class="{{@root.textClass}} clamp-[text,16px,18px] leading-tight font-medium tracking-[-0.18px] transition-colors duration-300">{{text}}</span>
        {{#if icon}}
            <i class="{{icon}} {{@root.iconClass}} clamp-[text,16px,18px] clamp-[h,16px,18px] transition-colors duration-300"></i>
        {{/if}}
    </a>
{{/if}}