{{> partials/header.hbs }}

<main>
    <div class="w-full h-(--headerHeight) bg-white"></div>
    <div class="clamp-[py,25px,50px] bg-white">
        <div class="container">
            {{> partials/components/breadcrumb.hbs
                breadcrumb=(array
                    (object text="Ana Sayfa" url="index.html")
                    (object text="Hizmet Bölgeleri" url="locations.html")
                )
            }}
        </div>
    </div>
    {{> partials/components/hero.hbs
        title="İstanbul'daki Hizmet Bölgelerimiz"
        description="Panelix olarak Bakırköy merkezli servis yapımızla Avrupa ve Anadolu Yakası'nda birçok ilçeye televizyon teknik servis desteği sunuyoruz. TV panel değişimi, ekran arızası, LED sorunları ve görüntü problemlerinde size en yakın çözümü planlıyoruz."
        miniCards=true
        miniCardsContent=(array
            (object title="Bakırköy Merkezli Servis" icon="assets/image/index/icon-1.svg")
            (object title="İstanbul Geneli Destek" icon="assets/image/index/icon-2.svg")
            (object title="Hızlı Ön Bilgilendirme" icon="assets/image/index/icon-3.svg")
        )
    }}
    <section data-module style="--min-pt: 50; --max-pt: 50; --min-pb: 50; --max-pb: 100; --min-w: 768; --max-w: 1600;">
        <div class="container">
            <div class="max-w-268 mx-auto flex flex-col items-center gap-6 clamp-[mb,24px,50px]">
                <h2 class="text-h2 text-dark text-center *:text-secondary">İstanbul'un Tüm Bölgelerine Servis Desteği</h2>
                <p class="text-body text-text text-center">Bakırköy merkezli servis yapımızla Avrupa ve Anadolu Yakası'ndaki tüm ilçelere televizyon teknik servis hizmeti sunuyoruz. Bölgeye göre planlama yaparak hızlı ve kontrollü çözüm sağlıyoruz.</p>
            </div>

            <div class="grid grid-cols-2 gap-6 max-lg:grid-cols-1">
                <div class="rounded-3xl border border-dark/10 bg-white clamp-[p,18px,28px] shadow-[0_18px_30px_-12px_rgba(30,64,175,0.10)]">
                    <div class="flex flex-col items-center gap-4 clamp-[mb,20px,28px] text-center">
                        <div class="w-fit bg-secondary/10 inline-flex items-center clamp-[gap,16px,24px] px-6 py-3 rounded-4xl">
                            <span class="clamp-[text,16px,20px] leading-tight font-medium tracking-[-0.2px] text-secondary">Avrupa Yakası</span>
                        </div>
                        <p class="text-body text-text">Avrupa Yakası'nda aşağıdaki ilçelerde servis planlaması yapıyoruz.</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4 max-md:grid-cols-1">
                        {{#each (array
                            (object title="Arnavutköy")
                            (object title="Avcılar")
                            (object title="Bağcılar")
                            (object title="Bahçelievler")
                            (object title="Bakırköy")
                            (object title="Başakşehir")
                            (object title="Bayrampaşa")
                            (object title="Beşiktaş")
                            (object title="Beyoğlu")
                            (object title="Büyükçekmece")
                            (object title="Çatalca")
                            (object title="Esenler")
                            (object title="Esenyurt")
                            (object title="Eyüpsultan")
                            (object title="Fatih")
                            (object title="Gaziosmanpaşa")
                            (object title="Güngören")
                            (object title="Kağıthane")
                            (object title="Küçükçekmece")
                            (object title="Sarıyer")
                            (object title="Silivri")
                            (object title="Sultangazi")
                            (object title="Şişli")
                            (object title="Zeytinburnu")
                            (object title="Beylikdüzü")
                        ) as |item|}}
                            <article class="rounded-2xl border border-secondary px-5 py-7 shadow-[0_18px_30px_-12px_rgba(30,64,175,0.12)] flex items-center justify-center text-center">
                                <h3 class="clamp-[text,20px,28px] font-semibold clamp-[tracking,-0.2px,-0.28px] text-dark">{{item.title}}</h3>
                            </article>
                        {{/each}}
                    </div>
                </div>

                <div class="rounded-3xl border border-dark/10 bg-white clamp-[p,18px,28px] shadow-[0_18px_30px_-12px_rgba(30,64,175,0.10)]">
                    <div class="flex flex-col items-center gap-4 clamp-[mb,20px,28px] text-center">
                        <div class="w-fit bg-secondary/10 inline-flex items-center clamp-[gap,16px,24px] px-6 py-3 rounded-4xl">
                            <span class="clamp-[text,16px,20px] leading-tight font-medium tracking-[-0.2px] text-secondary">Anadolu Yakası</span>
                        </div>
                        <p class="text-body text-text">Anadolu Yakası'nda aşağıdaki ilçelerde servis planlaması yapıyoruz.</p>
                    </div>
                    <div class="grid grid-cols-2 gap-4 max-md:grid-cols-1">
                        {{#each (array
                            (object title="Adalar")
                            (object title="Ataşehir")
                            (object title="Beykoz")
                            (object title="Çekmeköy")
                            (object title="Kadıköy")
                            (object title="Kartal")
                            (object title="Maltepe")
                            (object title="Pendik")
                            (object title="Sancaktepe")
                            (object title="Sultanbeyli")
                            (object title="Şile")
                            (object title="Tuzla")
                            (object title="Ümraniye")
                            (object title="Üsküdar")
                        ) as |item|}}
                            <article class="rounded-2xl border border-secondary px-5 py-7 shadow-[0_18px_30px_-12px_rgba(30,64,175,0.12)] flex items-center justify-center text-center">
                                <h3 class="clamp-[text,20px,28px] font-semibold clamp-[tracking,-0.2px,-0.28px] text-dark">{{item.title}}</h3>
                            </article>
                        {{/each}}
                    </div>
                </div>
            </div>
        </div>
    </section>
    {{> partials/components/cta.hbs
        title="Bölgenizde servis olup olmadığını öğrenmek ister misiniz?"
        description="İlçe ve mahalle bilgisini WhatsApp'tan paylaşın, size en uygun servis planını hızlıca iletelim."
        minPt=50 maxPt=50 minPb=50 maxPb=80
    }}
    {{> partials/components/seo.hbs
        editor="<h2>İstanbul'da Semt Bazlı Televizyon Servisi</h2><p>Panelix olarak Bakırköy merkezli servis yapımızla İstanbul'un birçok bölgesine televizyon teknik servis desteği sağlıyoruz. Servis planlamasını ilçeye ve arıza tipine göre yaparak hızlı, düzenli ve şeffaf bir süreç sunuyoruz.</p><h3>Hangi Arızalarda Destek Veriyoruz?</h3><p>TV panel değişimi, kırık ekran, LED arızası, görüntü gelmeme, çizgi oluşumu, kararma ve benzeri teknik sorunlarda uygun çözüm sürecini belirliyoruz. Marka ve model fark etmeksizin ön değerlendirme yapıp sizi doğru yönlendiriyoruz.</p><h3>Size En Yakın Servis Planlaması</h3><p>Avrupa ve Anadolu Yakası'nda farklı ilçelere servis desteği verirken, mümkün olan en hızlı çözüm için bölgesel planlama yapıyoruz. WhatsApp üzerinden konum ve cihaz bilgisi paylaşmanız yeterli.</p>"
        minPb=50 maxPb=80
    }}
    {{> partials/components/faq.hbs
        minPb=50 maxPb=100
        array=(array
            (object title="Hangi bölgelere servis veriyorsunuz?" description="Bakırköy merkezli yapımızla İstanbul'un birçok ilçesine hizmet veriyoruz. Avrupa ve Anadolu Yakası'nda semt bazlı servis planlaması yapıyoruz.")
            (object title="Servis için adres paylaşmam gerekir mi?" description="Evet, ilçe ve mümkünse mahalle bilgisini paylaşmanız servis planını daha hızlı oluşturmamıza yardımcı olur.")
            (object title="Aynı gün servis mümkün mü?" description="Bölge yoğunluğuna ve arıza durumuna göre aynı gün veya en yakın zaman için planlama yapılabilir.")
            (object title="Bölge dışında kalırsam yardımcı olur musunuz?" description="İlçeniz listede olmasa bile bize ulaşabilirsiniz. Uygun servis planı için durumu değerlendirelim.")
        )
    }}
</main>

{{> partials/footer.hbs }}
