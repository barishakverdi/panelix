<section data-module style="--min-pt: {{minPt}}; --max-pt: {{maxPt}}; --min-pb: {{minPb}}; --max-pb: {{maxPb}}; --min-w: {{#if minW}}{{minW}}{{else}}768{{/if}}; --max-w: {{#if maxW}}{{maxW}}{{else}}1600{{/if}}">
    <div class="container">
        <div class="grid grid-cols-12 max-lg:grid-cols-1">
            <div class="col-span-1 max-lg:hidden"></div>
            <div class="lg:col-span-10">
                <article class="editor">{{{editor}}}</article>
            </div>
            <div class="col-span-1 max-lg:hidden"></div>
        </div>
    </div>
</section>