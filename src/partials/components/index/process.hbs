<section data-module style="--min-pt: {{minPt}}; --max-pt: {{maxPt}}; --min-pb: {{minPb}}; --max-pb: {{maxPb}}; --min-w: {{#if minW}}{{minW}}{{else}}768{{/if}}; --max-w: {{#if maxW}}{{maxW}}{{else}}1600{{/if}}">
    <div class="bg-[#EEEEEE] clamp-[py,50px,100px]">
        <div class="container">
            <div class="flex flex-col items-center clamp-[gap,16px,24px] clamp-[mb,24px,50px]">
                <div class="w-fit bg-secondary/10 inline-flex items-center clamp-[gap,16px,24px] px-6 py-3 rounded-4xl">
                    <i class="icon-screwdriver clamp-[text,18px,21px] clamp-[h,18px,21px] text-secondary"></i>
                    <span class="clamp-[text,16px,20px] leading-tight font-medium tracking-[-0.2px] text-secondary">Servis Süreci</span>
                </div>
                <h2 class="text-h2 text-dark text-center *:text-secondary">4 Adımda Kolay ve Güvenilir Servis Süreci</h2>
            </div>
            <div class="w-full flex clamp-[mb,50px,100px] max-lg:grid max-lg:grid-cols-2 max-lg:gap-4 max-md:grid-cols-1">
                {{#each index.process as |item|}}
                    <div class="w-full">
                        <div class="clamp-[h,180px,212px] bg-primary clamp-[py,30px,48px] clamp-[px,20px,55px] clamp-[rounded,12px,24px] flex-center relative mb-7.5">
                            <img src="{{item.icon}}" alt="" loading="lazy" width="120" height="80" class="full-contain">
                            <div class="absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 w-full flex-center">
                                <p class="w-fit bg-secondary px-4 py-2 rounded-4xl text-[14px] leading-tight font-semibold tracking-[-0.14px] text-white text-center">{{item.subTitle}}</p>
                            </div>
                        </div>
                        <div>
                            <h3 class="clamp-[text,24px,30px] leading-tight font-medium tracking-[-0.3px] text-dark mb-3">{{item.title}}</h3>
                            <p class="text-[16px] leading-[1.8] tracking-[-0.08px] text-text">{{item.description}}</p>
                        </div>
                    </div>
                    <div class="clamp-[w,30px,80px] shrink-0 clamp-[pt,30px,106px] last:hidden max-lg:hidden">
                        <div class="relative">
                            <div class="w-full h-px border-t border-dashed border-black/10"></div>
                            <i class="icon-angle-right text-[10px] h-2.5 text-accent absolute-center"></i>
                        </div>
                    </div>
                {{/each}}
            </div>
            <div class="w-full max-w-165.25 mx-auto flex clamp-[gap,10px,20px] *:w-full max-md:flex-col">
                {{> partials/components/button.hbs
                    text="Fiyat Teklifi Al"
                    icon="icon-phone"
                    url="tel:+905350577188"
                    color="primary"
                }}
                {{> partials/components/button.hbs
                    text="Whatsapp’tan Fiyat Sor"
                    icon="icon-whatsapp"
                    url="https://wa.me/+905350577188"
                    color="whatsapp"
                }}
            </div>
        </div>
    </div>
</section>