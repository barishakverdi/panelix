<section data-module style="--min-pt: {{minPt}}; --max-pt: {{maxPt}}; --min-pb: {{minPb}}; --max-pb: {{maxPb}}; --min-w: {{#if minW}}{{minW}}{{else}}768{{/if}}; --max-w: {{#if maxW}}{{maxW}}{{else}}1600{{/if}}">
    <div class="container">
        <div class="bg-fixed bg-no-repeat bg-center bg-cover clamp-[px,20px,80px] clamp-[py,30px,60px] rounded-xl relative overflow-hidden" style="background-image: url('assets/image/cta.jpg')">
            <div class="absolute-full bg-black/60"></div>
            <div class="w-full max-w-2xl relative z-2">
                <div class="clamp-[mb,30px,50px]">
                    <h2 class="text-h3 text-white mb-5">{{title}}</h2>
                    <p class="text-body text-white">{{description}}</p>
                </div>
                <div class="flex clamp-[gap,10px,20px] *:w-full max-xs:flex-col">
                    {{> partials/components/button.hbs
                        text="WhatsApp’tan Bilgi Al"
                        icon="icon-whatsapp"
                        url="https://wa.me/+905350577188"
                        color="whatsapp"
                    }}
                    {{> partials/components/button.hbs
                        text="Hemen Ara"
                        icon="icon-phone"
                        url="tel:+905350577188"
                        color="primary"
                    }}
                </div>
            </div>
        </div>
    </div>
</section>